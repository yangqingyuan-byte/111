        </mxCell>
        <mxCell id="dropout" value="Dropout&#10;增强鲁棒性并抑制过拟合" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="2330" y="650" width="250" height="86" as="geometry"/>
        </mxCell>
        <mxCell id="freqNote" value="机制解释：FreTS 不显式划分局部子带，而是在全局频谱上学习复数滤波响应，&#10;通过软阈值保留主导频率、削弱弱噪声频率，更偏向周期性与长期趋势建模。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1500" y="655" width="760" height="96" as="geometry"/>
        </mxCell>

        <mxCell id="secC" value="C. 时序汇聚与变量级频域表示生成" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=18;" vertex="1" parent="1">
