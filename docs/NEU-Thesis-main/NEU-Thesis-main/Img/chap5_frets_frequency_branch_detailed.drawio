        <mxCell id="secB" value="B. FreTS 核心：复频域可学习变换与稀疏化" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="40" y="385" width="2440" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="rfft" value="RFFT&#10;沿时间维进入复频域&#10;X_f in C^(B*N x F x C)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="90" y="490" width="240" height="108" as="geometry"/>
        </mxCell>
        <mxCell id="realPart" value="实部路径输入&#10;Re(X_f)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="430" y="470" width="170" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="imagPart" value="虚部路径输入&#10;Im(X_f)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="430" y="565" width="170" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="paramNote" value="可学习参数&#10;R, I in R^(C x C)&#10;b_r, b_i in R^C&#10;scale = 0.018" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="650" y="445" width="190" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="realOut" value="实部变换结果&#10;ReLU(Re(X_f)R - Im(X_f)I + b_r)&#10;O_real" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;" vertex="1" parent="1">
