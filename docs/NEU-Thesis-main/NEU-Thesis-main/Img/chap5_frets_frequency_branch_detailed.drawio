          <mxGeometry x="820" y="945" width="220" height="82" as="geometry"/>
        </mxCell>
        <mxCell id="weighted" value="加权汇聚&#10;z_fre = Sum(a_t * H_fre_raw[t])&#10;z_fre in R^(B*N x C)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;" vertex="1" parent="1">
